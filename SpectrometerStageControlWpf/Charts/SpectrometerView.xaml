<Window x:Class="SpectrometerStageControlWpf.SpectrometerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectrometerStageControlWpf"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vms="clr-namespace:SpectrometerStageControlWpf"
        mc:Ignorable="d"
        KeyDown="Window_KeyDown"
        Title="Spectrometer Chart" Height="450" Width="800">
    <Grid>
        <lvc:CartesianChart 
            Margin="10, 35, 0, 0" 
            Name="lvcSpectrometerChart" 
            Series="{Binding Series}" 
            XAxes="{Binding XAxes}" 
            YAxes="{Binding YAxes}" 
            SyncContext="{Binding Sync}"/>
        <Button Name="btnAcquire" Content="Toggle Acq" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="75"/>
        <CheckBox Name="chkNormalized" Content="Normalized" HorizontalAlignment="Left" Margin="103,13,0,0" VerticalAlignment="Top" IsChecked="false"/>
        <CheckBox Name="chkTestData" Content="Use Random Test Data" HorizontalAlignment="Left" Margin="198,13,0,0" VerticalAlignment="Top" IsChecked="false"/>

        <!-- <lvc:CartesianChart Margin="10, 35, 0, 0" Name="lvcSpectrometerChart" SyncContext="{Binding Sync}"/> -->
    </Grid>
</Window>
