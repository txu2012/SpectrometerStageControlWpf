<Window x:Class="SpectrometerStageControlWpf.SpectrometerChart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectrometerStageControlWpf"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vms="clr-namespace:SpectrometerStageControlWpf"
        mc:Ignorable="d"
        Title="Spectrometer Chart" Height="450" Width="800">
    <Grid>
        <lvc:CartesianChart Name="lvcSpectrometerChart" Series="{Binding Series}" XAxes="{Binding XAxis}">
        </lvc:CartesianChart>
    </Grid>
</Window>
